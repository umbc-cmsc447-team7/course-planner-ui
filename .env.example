# Leave empty in development: Vite proxies /api to localhost:8000 and
# /prereq-graph to localhost:8001 (see vite.config.js).
VITE_API_URL=
# Base URL of Team B's prerequisite graph service when it is deployed.
VITE_GRAPH_API_URL=

# Optional: change where the dev proxy sends requests.
# API_PROXY_TARGET=http://localhost:8000
# GRAPH_PROXY_TARGET=http://localhost:8001
