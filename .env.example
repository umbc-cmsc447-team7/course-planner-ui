# Leave empty. The browser calls /courses and /prereq-graph on this app's
# origin. Vite proxies those in development (vite.config.js), and vercel.json
# rewrites them in production. Do not set this to Team B's host: that API
# does not send CORS headers, so the browser would block the request.
VITE_API_URL=

# Optional: where the dev server forwards /courses and /prereq-graph.
# API_PROXY_TARGET=https://course-prereq-team3.fastapicloud.dev
